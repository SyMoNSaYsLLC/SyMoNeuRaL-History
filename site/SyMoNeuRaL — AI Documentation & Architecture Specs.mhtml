ng: -0.016em; font-weight: 660; }

.sub { margin: 14px 0px 0px; color: var(--dim); max-width: 72ch; }

.grid { display: grid; gap: 16px; margin-top: 34px; }

.g2 { grid-template-columns: repeat(2, 1fr); }

