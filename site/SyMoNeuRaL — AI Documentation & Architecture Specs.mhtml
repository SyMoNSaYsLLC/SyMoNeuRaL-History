@charset "utf-8";

:root { --bg: #0e100f; --panel: #161a18; --line: #28302b; --fg: #f2f6f3; --=
dim: #a8b3ac; --faint: #77837b; --accent: #2ee08a; --accent-ink: #06170f; -=
-amber: #ffab3d; --panel2: #1c221e; --max: 1120px; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 92px; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}

body { margin: 0px; background: var(--bg); color: var(--fg); font: 16px / 1=
.65 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Inter, sans-serif;=
 -webkit-font-smoothing: antialiased; }

a { color: inherit; }

img { max-width: 100%; display: block; }

.wrap { max-width: var(--max); margin: 0px auto; padding: 0px 28px; }

h1, h2, h3 { text-wrap: balance; }

::selection { background: rgba(46, 224, 138, 0.28); }

.status { background: linear-gradient(90deg, rgba(255, 171, 61, 0.16), rgba=
(255, 171, 61, 0.05) 70%); border-bottom: 1px solid rgba(255, 171, 61, 0.32=
); }

.status .wrap { display: flex; align-items: center; gap: 14px; flex-wrap: w=
rap; padding-top: 12px; padding-bottom: 12px; }

.status b { display: inline-flex; align-items: center; gap: 8px; font-size:=
 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;=
 color: var(--accent-ink); background: var(--amber); border-radius: 999px; =
padding: 5px 13px; white-space: nowrap; }

.status b s { width: 7px; height: 7px; border-radius: 50%; background: var(=
--accent-ink); text-decoration: none; display: block; animation: 2.4s ease-=
in-out 0s infinite normal none running pulse; }

@keyframes pulse {=20
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

@media (prefers-reduced-motion: reduce) {
  .status b s { animation: auto ease 0s 1 normal none running none; }
}

.status span { color: rgb(240, 211, 166); font-size: 14.5px; }

header { position: sticky; top: 0px; z-index: 20; backdrop-filter: blur(14p=
x); background: rgba(14, 16, 15, 0.84); border-bottom: 1px solid var(--line=
); }

header .bar { display: flex; align-items: center; gap: 14px; height: 66px; =
}

.logo { display: flex; align-items: center; gap: 11px; text-decoration: non=
e; font-weight: 650; letter-spacing: 0.01em; }

.logo img { width: 30px; height: 30px; }

.logo b { font-weight: 650; }

header .bar i, .logo b i { display: inline; height: auto; width: auto; back=
ground: none; box-shadow: none; border-radius: 0px; animation: auto ease 0s=
 1 normal none running none; font-style: normal; color: var(--accent); }

nav { margin-left: auto; display: flex; align-items: center; gap: 24px; }

nav a { color: var(--dim); text-decoration: none; font-size: 14.5px; }

nav a:hover { color: var(--fg); }

a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; bo=
rder-radius: 4px; }

.cta { display: inline-flex; align-items: center; gap: 8px; text-decoration=
: none; background: var(--accent); color: var(--accent-ink); font-weight: 6=
50; font-size: 14.5px; padding: 9px 18px; border-radius: 999px; border: 1px=
