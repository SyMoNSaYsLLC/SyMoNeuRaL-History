.cta.ghost:hover { background: var(--panel2); border-color: rgb(58, 69, 62)=
; }

@media (max-width: 940px) {
  nav a:not(.cta) { display: none; }
}

.hero { padding: 80px 0px 64px; position: relative; overflow: hidden; }

.hero::before { content: ""; position: absolute; inset: -40% 32% auto -20%;=
 height: 640px; background: radial-gradient(closest-side, rgba(46, 224, 138=
, 0.13), transparent 72%); pointer-events: none; }

.hero .wrap { position: relative; }

.eyebrow { font-size: 12px; letter-spacing: 0.17em; text-transform: upperca=
se; color: var(--accent); margin: 0px 0px 18px; font-weight: 600; }

.hero h1 { margin: 0px; font-size: clamp(32px, 4.6vw, 50px); line-height: 1=
.08; letter-spacing: -0.022em; font-weight: 680; max-width: 20ch; }

.hero h1 i { font-style: normal; color: var(--accent); }

.lede { margin: 22px 0px 0px; color: var(--dim); font-size: 17.5px; max-wid=
th: 66ch; }

.actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }

section { padding: 70px 0px; border-top: 1px solid var(--line); }

