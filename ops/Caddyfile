# SyMoNeuRaL — symoneural.com
#
# The rule this file exists to enforce: **FastAPI does all the routing.** This server
# terminates TLS and hands back static files, and everything else is a reverse proxy.
# There are no rewrites, no aliases and no conditional logic here, because every one of
# those would be a routing decision made outside the API.
#
# There are now two upstreams, and the rule still holds:
#
#     internet -> Caddy :443 -> symon-gateway :8000 -> FastAPI :8800
#                            \-> FastAPI :8800 (sections, /docs, /openapi.json)
#
# symon-gateway forwards every /api path to FastAPI verbatim -- it rewrites no path and
# makes no routing decision, it only validates payloads before they can reach anything
# that takes the GPU lock, and it relays /api/ws as a real WebSocket. Caddy was chosen
# over Apache partly for that upgrade (see 1. below); the gateway had to learn it too,
# and did, before this file was pointed at it.
#
# X-Forwarded-For is load-bearing here -- api.py keys its rate limiter on it -- and the
# handling is Caddy's default on purpose. The /api block explains what was tested and why
# an explicit header_up would be a no-op.
#
# Why Caddy rather than Apache:
#
#   1. WebSockets. The rack claims it is "pushed live over one socket -- the machine
#      tells the page when something changes rather than the page asking". Under Apache
#      that needed mod_proxy_wstunnel, which was never enabled, so /api/ws could not
#      upgrade and console.js silently fell back to polling /api/status. The page was
#      making a claim the deployment could not honour. Caddy's reverse_proxy handles
#      the upgrade with no directive at all.
#   2. TLS is automatic and renews itself. No certbot, no renewal hook, no cron.
#   3. The whole config is this file, and it is short enough to audit in one screen --
#      which matters when the argument of the site is that its infrastructure is honest.
#
# Install with scripts/install-caddy.sh (needs sudo; it disables apache2 first).

symoneural.com, www.symoneural.com {
	# Static frontend. This is the only thing served off disk.
	root * /var/www/symoneural

	# --- everything below is routed by FastAPI ---------------------------------
	# /api covers the surfaces, the status feed and /api/ws. The WebSocket upgrade
	# needs no special handling; reverse_proxy passes it through.
	#
	# The hop is now :8000 (symon-gateway), not :8800 (FastAPI) directly. That does
	# NOT make a routing decision here -- the gateway forwards every /api path to
	# FastAPI verbatim and rewrites nothing, so backend/api.py still owns the path
	# exactly as before. What the extra hop buys is payload validation before a
	# request can reach anything that takes the GPU lock.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# Streaming endpoints (chat tokens, the status socket) must not be
			# buffered, or the whole point of watching tokens land is lost.
			flush_interval -1

			# There is deliberately no `header_up X-Forwarded-For` here, and
			# that is worth a note because adding one looks like the obvious
			# hardening step.
			#
			# api.py:505 and api.py:1771 key the rate limiter on the FIRST
			# entry of X-Forwarded-For, so if Caddy appended the real client to
			# a client-supplied header, anyone sending `X-Forwarded-For:
			# <anything>` would sit in first position and get a fresh bucket per
			# request. Caddy does not append: since 2.7 `trusted_proxies`
			# defaults to none, so an untrusted inbound X-Forwarded-For is
			# REPLACED with the real peer.
			#
			# Tested here rather than assumed -- a request carrying
			# `X-Forwarded-For: 1.2.3.4` arrives upstream as `127.0.0.1`, the
			# actual peer, with and without an explicit header_up. So the
			# explicit form is a no-op that also makes `caddy validate` print a
			# warning on every reload, and a permanent warning is how real
			# warnings get ignored.
			#
			# The gateway then runs with SYMON_TRUST_FORWARDED=1 and appends its
			# own hop, so FastAPI sees `<real client>, 127.0.0.1` and reads the
			# real client first. If a proxy is ever put in FRONT of Caddy, this
			# is the block that has to change: Caddy would then be replacing a
			# header the front proxy legitimately wrote, and it needs
			# `trusted_proxies` naming that proxy.
		}
	}

	# The OpenAI-compatible surface, and the gateway's own Swagger UI. Note this is
	# /swagger-ui and NOT /docs: /docs below is FastAPI's own schema and still goes
	# straight to :8800. Two API documents, two addresses, neither shadowing the other.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			# No header_up here either -- see the /api block above for why.
		}
	}
	handle /swagger-ui* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api-docs/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Swagger UI and its schema are generated by FastAPI, not copied to disk.
	handle /docs* {
		reverse_proxy 127.0.0.1:8800
	}
	handle /openapi.json {
		reverse_proxy 127.0.0.1:8800
	}

	# The four front-page sections at their own addresses. These are FastAPI routes, not
	# files on disk, so without this block `file_server` below looks for a file called
	# "overview", does not find one, and returns 404 without ever asking the API. That is
	# exactly what happened when they were first deployed.
	#
	# This is a DELEGATION, not a rewrite or an alias -- the same shape as /docs* above.
	# The URL is not being mapped to a different resource here; this only says which
	# process owns the path. The rule in .claude/CLAUDE.md is that no routing DECISION is
	# made in this file, and none is: backend/api.py decides what /livestack returns.
	#
	# The cost is that the path list now lives in two files. Adding a fifth section means
	# editing this block as well as tools/build_split.py and backend/api.py. The assertion
	# `each section has its own URL` in tests/frontend.mjs hits all four and requires 200,
	# so running the suite against production catches the omission immediately -- run it
	# there after any change here, because against localhost the API answers directly and
	# this block is not exercised at all.
	# `/` is in this list so the API can redirect it to /overview. `path /` is an EXACT
	# match -- it does not cover /anything-else, which still falls through to file_server
	# below. Without this line the redirect route in api.py is dead code: Caddy would serve
	# index.html off disk and never ask.
	@sections path / /overview /livestack /controlboard /receipts
	handle @sections {
		reverse_proxy 127.0.0.1:8800
	}

	# SyMoNeuRaL Studio: the agent page at /studio, and the render UI's own node editor
	# reverse-proxied by FastAPI at /studio/editor/*.
	#
	# Same shape and same reason as @sections above -- a DELEGATION, not a rewrite. Neither
	# path is a file on disk, so without this block file_server looks for
	# /var/www/symoneural/studio, does not find it, and 404s without ever asking the API.
	# Against localhost the API answers directly and this block is not exercised at all, so
	# run tests/frontend.mjs against production after changing it.
	#
	# `handle` covers the subtree, which is what /studio/editor/* needs: one page open pulls
	# dozens of assets and opens a WebSocket at /studio/editor/ws. The upgrade needs no
	# directive here -- that is the reason this file is Caddy and not Apache (see 1. above).
	#
	# flush_interval -1 because /api/studio/agent streams the agent's reasoning as SSE and
	# the editor streams render progress; buffered, both arrive in one lump at the end and
	# look like a hang. That path is under /api and already covered above, but the editor's
	# own socket comes through HERE.
	@studio path /studio /studio/*
	handle @studio {
		reverse_proxy 127.0.0.1:8800 {
			flush_interval -1
		}
	}

	# The plugin runtime's page at /exp. Same delegation, one line shorter, and the
	# differences are the point:
	#
	#   * `path /exp` EXACT, not `/exp/*`. There is no subtree -- the runtime's reads live at
	#     /api/exp/*, already delegated by the /api block above -- and a wildcard here would
	#     claim addresses nothing serves.
	#   * No `flush_interval -1`. The page polls /api/exp/events with a cursor rather than
	#     holding a stream open, so there is nothing here to unbuffer. Copying the directive
	#     across from @studio would be cargo cult: it would read as "this streams" to the next
	#     person, and it does not.
	#
	# Added in the same change as the /exp route and the rack row, because @sections' comment
	# is the record of what happens otherwise: file_server looks for /var/www/symoneural/exp,
	# does not find it, and 404s without asking the API -- while localhost answers perfectly.
	@exp path /exp
	handle @exp {
		reverse_proxy 127.0.0.1:8800
	}

	# SyMoNeuRaL Live at /livestack/live. The fourth delegation to be added for the same
	# reason as the three above, which is the whole argument for writing it down each time:
	# @sections matches `/livestack` EXACTLY, so it does NOT cover the child, and
	# `handle { file_server }` below looks for /var/www/symoneural/livestack/live, does not
	# find it, and 404s the page WITHOUT ASKING THE API -- while 127.0.0.1:8800 answers it
	# perfectly. apps/test_caddy_delegation.py went red on exactly this and is the only
	# reason it was caught before he opened the tab.
	#
	#   * `path` EXACT, like @exp. There is no subtree: the manifests and MPEG-TS segments
	#     are served from /api/live/hls/*, already delegated by the /api block above. A
	#     wildcard here would claim addresses nothing serves.
	#   * No `flush_interval -1`. site/live.js POLLS /api/live/state and /api/live/vods on a
	#     5 s timer; it holds no stream open, so there is nothing here to unbuffer. Video
	#     arrives as ordinary segment GETs, not as a socket. Copying the directive across
	#     from @studio would read as "this streams" to the next person, and it does not --
	#     the streaming is HLS, which is precisely a design that needs no long-lived hop.
	#   * BOTH spellings since 2026-08-22, like @coder. This block listed only
	#     /livestack/live until #81 added the hyphenated twin in api.py -- at which point
	#     apps/test_caddy_delegation.py went red naming /live-stack/live, which is the
	#     third time that test has caught a delegation before a visitor did.
	@live path /livestack/live /live-stack/live
	handle @live {
		reverse_proxy 127.0.0.1:8800
	}

	# SyMoNeuRaL Coder at BOTH spellings of one address. The fifth delegation added for the
	# reason the four above each learned separately, and the first to be caught by
	# apps/test_caddy_delegation.py before it ever reached the internet rather than after --
	# that test went red naming both paths, which is the whole return on writing it.
	#
	#   * TWO exact paths, not a prefix, and not one canonical spelling with a redirect.
	#     `/live-stack/coder` is what Garrett typed and leads; `/livestack/coder` matches
	#     every other application on the rack. backend/api.py serves one page at both and
	#     redirects neither, so the address in the operator's URL bar keeps agreeing with the
	#     address they typed. @sections matches `/livestack` EXACTLY and so covers neither.
	#   * No subtree, like @exp and @live. The page's own CSS and JS are ordinary files and
	#     must keep being served off disk by `handle { file_server }` below.
	#   * No `flush_interval -1`. site/coder.js polls; it holds no stream open and opens no
	#     socket. Copying that directive across from @studio would read as "this streams" to
	#     the next person, and it does not.
	#
	# WHAT IS DELIBERATELY ABSENT FROM THIS BLOCK IS THE WHOLE SAFETY CASE, so it is written
	# here as well as in api.py. The page's reads live at `/local/coder/*`, and there is no
	# matcher for them and must never be one. `/local/*` falls through to file_server, is
	# looked up in /var/www/symoneural, and 404s from disk without this process being asked.
	# `backend/apps/coder/__init__.py` executes subprocesses and reads arbitrary workspace
	# files; a `handle /local*` block here would put that on the public internet in one line.
	# api.py's `_require_local` refuses the request anyway -- it checks the socket peer and
	# rejects proxy headers -- so this is the second of two locks, not the only one.
	@coder path /live-stack/coder /livestack/coder
	handle @coder {
		reverse_proxy 127.0.0.1:8800
	}

	# SyMoNeuRaL Image at both spellings, and the first block here that is one entry of a
	# LIST rather than a page of its own. #81 moves every application to
	# /livestack/<name>, so this block grows a path pair per application and
	# `backend/api.py`'s LIVESTACK_PAGES is the source both halves are read from --
	# apps/test_caddy_delegation.py parses that dict and requires a matcher for both
	# spellings of every key, so adding the next application makes this block go red
	# rather than making the page 404.
	#
	# The sixth delegation added for the reason the five above each learned separately, and
	# the reason has not changed: @sections matches `/livestack` EXACTLY, so it does not
	# cover the child, and `handle { file_server }` below looks for
	# /var/www/symoneural/livestack/image, does not find it, and 404s WITHOUT ASKING THE
	# API -- while 127.0.0.1:8800 answers it perfectly.
	#
	#   * `path` EXACT, like @exp, @live and @coder. There is no subtree. `/image.html`,
	#     `/image.css` and `/image.js` are ordinary files and must keep being served off
	#     disk by `handle { file_server }` below -- a prefix here would claim the two new
	#     assets #81 split out and proxy them through the API for no reason.
	#   * No `flush_interval -1`. The page POSTs /api/image once and awaits one JSON reply;
	#     it holds no stream open and opens no socket. That path is under /api and already
	#     covered above. Copying the directive from @studio would read as "this streams" to
	#     the next person, and it does not.
	@livestackpages path /livestack/image /live-stack/image
	handle @livestackpages {
		reverse_proxy 127.0.0.1:8800
	}

	# The two retired page names. `backend/api.py` redirects /tuner.html -> /streamer.html
	# and /tuner-watch.html -> /streamer-watch.html, and its comment states why they get a
	# redirect when /api/tuner/* deliberately does not: *"a bookmark is permanent"* and,
	# unlike a stale cached page, it does not resolve itself on a reload.
	#
	# That redirect was DEAD CODE on the public origin until this block, and the way it was
	# hidden is worth writing down. The old files were still sitting in the webroot, so
	# file_server served them -- stale 200s that looked healthy. On 2026-08-20 the first
	# unattended `deploy.sh --prune` removed both, and the paths went straight from
	# stale-200 to hard-404: `handle { file_server }` below finds no file and answers
	# without ever asking the API, which is the same defect @sections, @studio and @exp
	# each had to learn one at a time. Verified against this box's Caddy, not against
	# 127.0.0.1:8800 -- the API answers these directly, so localhost showed 302 throughout
	# and proved nothing. Test a delegation THROUGH Caddy or you are testing the wrong hop.
	#
	# `path` is EXACT and lists both names, like @exp and unlike @studio: there is no
	# subtree here, only two dead bookmarks, and a wildcard would claim the retired
	# namespace forever -- which api.py's comment argues against directly.
	#
	# This block dies when the redirects do. It is not permanent infrastructure: when
	# api.py stops answering these two names, delete this too, or Caddy will proxy a path
	# that 404s from the API instead of from here, which is a worse-looking version of the
	# same nothing.
	@retired path /tuner.html /tuner-watch.html
	handle @retired {
		reverse_proxy 127.0.0.1:8800
	}

	# Anything else is a static file.
	handle {
		file_server
	}

	encode zstd gzip

	# Renders are immutable and content-addressed by timestamp and seed, but they are
	# served from /api/gen by the API, so this only covers the site's own assets.
	@static path *.css *.js *.png *.svg *.woff2
	header @static Cache-Control "public, max-age=604800"

	log {
		output file /var/log/caddy/symoneural.log
	}
}
