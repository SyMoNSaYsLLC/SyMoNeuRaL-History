# SyMoNeuRaL — symoneural.com
#
# The rule this file exists to enforce: **FastAPI does all the routing.** This server
# terminates TLS and hands back static files, and everything else is a reverse proxy.
# There are no rewrites, no aliases and no conditional logic here, because every one of
# those would be a routing decision made outside the API.
#
# There are now two upstreams, and the rule still holds:
#
#     internet -> Caddy :443 -> symon-gateway :8000 -> FastAPI :8800
#                            \-> FastAPI :8800 (sections, /docs, /openapi.json)
#
# symon-gateway forwards every /api path to FastAPI verbatim -- it rewrites no path and
# makes no routing decision, it only validates payloads before they can reach anything
# that takes the GPU lock, and it relays /api/ws as a real WebSocket. Caddy was chosen
# over Apache partly for that upgrade (see 1. below); the gateway had to learn it too,
# and did, before this file was pointed at it.
#
# X-Forwarded-For is load-bearing here -- api.py keys its rate limiter on it -- and the
# handling is Caddy's default on purpose. The /api block explains what was tested and why
# an explicit header_up would be a no-op.
#
# Why Caddy rather than Apache:
#
#   1. WebSockets. The rack claims it is "pushed live over one socket -- the machine
#      tells the page when something changes rather than the page asking". Under Apache
#      that needed mod_proxy_wstunnel, which was never enabled, so /api/ws could not
#      upgrade and console.js silently fell back to polling /api/status. The page was
#      making a claim the deployment could not honour. Caddy's reverse_proxy handles
#      the upgrade with no directive at all.
#   2. TLS is automatic and renews itself. No certbot, no renewal hook, no cron.
#   3. The whole config is this file, and it is short enough to audit in one screen --
#      which matters when the argument of the site is that its infrastructure is honest.
#
# Install with scripts/install-caddy.sh (needs sudo; it disables apache2 first).

symoneural.com, www.symoneural.com {
	# Static frontend. This is the only thing served off disk.
	root * /var/www/symoneural

	# --- everything below is routed by FastAPI ---------------------------------
	# /api covers the surfaces, the status feed and /api/ws. The WebSocket upgrade
	# needs no special handling; reverse_proxy passes it through.
	#
	# The hop is now :8000 (symon-gateway), not :8800 (FastAPI) directly. That does
	# NOT make a routing decision here -- the gateway forwards every /api path to
	# FastAPI verbatim and rewrites nothing, so backend/api.py still owns the path
	# exactly as before. What the extra hop buys is payload validation before a
	# request can reach anything that takes the GPU lock.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# Streaming endpoints (chat tokens, the status socket) must not be
			# buffered, or the whole point of watching tokens land is lost.
			flush_interval -1

			# There is deliberately no `header_up X-Forwarded-For` here, and
			# that is worth a note because adding one looks like the obvious
			# hardening step.
			#
			# api.py:505 and api.py:1771 key the rate limiter on the FIRST
			# entry of X-Forwarded-For, so if Caddy appended the real client to
			# a client-supplied header, anyone sending `X-Forwarded-For:
			# <anything>` would sit in first position and get a fresh bucket per
			# request. Caddy does not append: since 2.7 `trusted_proxies`
			# defaults to none, so an untrusted inbound X-Forwarded-For is
			# REPLACED with the real peer.
			#
			# Tested here rather than assumed -- a request carrying
			# `X-Forwarded-For: 1.2.3.4` arrives upstream as `127.0.0.1`, the
			# actual peer, with and without an explicit header_up. So the
			# explicit form is a no-op that also makes `caddy validate` print a
			# warning on every reload, and a permanent warning is how real
			# warnings get ignored.
			#
			# The gateway then runs with SYMON_TRUST_FORWARDED=1 and appends its
			# own hop, so FastAPI sees `<real client>, 127.0.0.1` and reads the
			# real client first. If a proxy is ever put in FRONT of Caddy, this
			# is the block that has to change: Caddy would then be replacing a
			# header the front proxy legitimately wrote, and it needs
			# `trusted_proxies` naming that proxy.
		}
	}

	# The OpenAI-compatible surface, and the gateway's own Swagger UI. Note this is
	# /swagger-ui and NOT /docs: /docs below is FastAPI's own schema and still goes
	# straight to :8800. Two API documents, two addresses, neither shadowing the other.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			# No header_up here either -- see the /api block above for why.
		}
	}
	handle /swagger-ui* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api-docs/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Swagger UI and its schema are generated by FastAPI, not copied to disk.
	handle /docs* {
		reverse_proxy 127.0.0.1:8800
	}
	handle /openapi.json {
		reverse_proxy 127.0.0.1:8800
	}

	# The four front-page sections at their own addresses. These are FastAPI routes, not
	# files on disk, so without this block `file_server` below looks for a file called
	# "overview", does not find one, and returns 404 without ever asking the API. That is
	# exactly what happened when they were first deployed.
	#
	# This is a DELEGATION, not a rewrite or an alias -- the same shape as /docs* above.
	# The URL is not being mapped to a different resource here; this only says which
	# process owns the path. The rule in .claude/CLAUDE.md is that no routing DECISION is
	# made in this file, and none is: backend/api.py decides what /livestack returns.
	#
	# The cost is that the path list now lives in two files. Adding a fifth section means
	# editing this block as well as tools/build_split.py and backend/api.py. The assertion
	# `each section has its own URL` in tests/frontend.mjs hits all four and requires 200,
	# so running the suite against production catches the omission immediately -- run it
	# there after any change here, because against localhost the API answers directly and
	# this block is not exercised at all.
	# `/` is in this list so the API can redirect it to /overview. `path /` is an EXACT
	# match -- it does not cover /anything-else, which still falls through to file_server
	# below. Without this line the redirect route in api.py is dead code: Caddy would serve
	# index.html off disk and never ask.
	@sections path / /overview /livestack /controlboard /receipts
	handle @sections {
		reverse_proxy 127.0.0.1:8800
	}

	# Anything else is a static file.
	handle {
		file_server
	}

	encode zstd gzip

	# Renders are immutable and content-addressed by timestamp and seed, but they are
	# served from /api/gen by the API, so this only covers the site's own assets.
	@static path *.css *.js *.png *.svg *.woff2
	header @static Cache-Control "public, max-age=604800"

	log {
		output file /var/log/caddy/symoneural.log
	}
}
