#!/usr/bin/env python3
"""SyMoNeuRaL -- one command over the whole local stack.

Three surfaces share one workstation, and they do not share it equally:

    chat    llama.cpp + Qwen2.5-7B Q4_K_M    8.1 GiB resident, measured   needs the card
    image   stable-diffusion.cpp + FLUX.1-schnell q4_k   11.8 GiB of weights   needs the card
    ravencalc   sympy, exact symbolic         CPU only, never queues       needs nothing

The chat figure is the whole resident cost measured on this box -- 4.36 GiB of weights plus
the adapter and the KV cache -- and it agrees with the ~8.2 GiB `backend/api.py` budgets for
the same spawn. The image figure is the four weight files summed with `ls`, not a resident
reading: sd.cpp is not ComfyUI, and the 13.1 GiB peak recorded for a 1024x1024 render in
HANDOVER belongs to that other engine. Both are verifiable by opening what they name.

The first two cannot be resident at the same time in 15.92 GiB, so every GPU
operation here goes through the governor, which serialises them and -- more
importantly -- waits for the driver to actually return the memory between
tenants. The third does not touch the GPU at all and therefore never queues:
that asymmetry is a fact about the work, not an implementation detail, and the
CLI is shaped to make it visible.

A fourth surface joined them and is not on that table because it does not own the
card: `agent`, `tools`, `tool`, `state` and `mcp` are a client for
`backend/apps/symoneuralstudio` -- 26 registered tools in four groups, native tool
calling, and an MCP transport. `agent` streams one turn's frames as they arrive and
takes the GPU only for as long as a tool it calls does. Its options are exactly the
five parameters `POST /api/studio/agent` reads -- `query`, `history` (`-c`, from a
transcript under `run/`), `max_steps`, `model` and `context` -- and no others, and it
needs the API's own `SYM_STUDIO_TOKEN` in the environment.

Deliberately stdlib-only apart from sympy, which the system interpreter already
carries -- `urllib` reads the SSE stream. `tools` and `mcp` additionally import the
backend's registry in-process, which costs httpx, already in the serving path.
Nothing here may be installed into the pinned base environment.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
# The CLI lives in bin/, so the repo root is one level up. This calculation has been
# wrong four times in this repo and it fails silently, because the wrong parent is
# usually a directory that exists. Assert it.
ROOT = HERE.parent
assert (ROOT / "backend" / "api.py").is_file(), f"repo root not found at {ROOT}"
MODELS = ROOT / "backend" / "models"
RUN = ROOT / "run"
GOVERNOR = ROOT / "scripts" / "gpu-governor.sh"
DEPLOY = ROOT / "scripts" / "deploy.sh"
UNIT = "symoneural-api"
# Where the packaged postinst records the outcome of its deploy. Read, never invented: the
# .deb's postinst writes one line here (`ok: <iso>`, `skipped: <why>`, or `FAILED: ...`) and
# this is the only place either command learns whether the last publish worked.
# SYM_STATE_DIR exists so the tests can point this at a tmpdir; nothing else sets it.
STATE = Path(os.environ.get("SYM_STATE_DIR", "/var/lib/symoneural"))

LLAMA_BIN = ROOT / "contrib" / "llama.cpp" / "build" / "bin"
SD_BUILD = ROOT / "contrib" / "stable-diffusion.cpp" / "build" / "bin"

# The resident workhorse, and the base the SyMoNeuRaL adapter is trained against. The 14B is
# the heavy tier -- better answers, ~98 tok/s instead of ~170, and no adapter.
CHAT_MODEL = MODELS / "llm" / "Qwen2.5-7B-Instruct-Q4_K_M.gguf"
CHAT_MODEL_HEAVY = MODELS / "llm" / "Qwen2.5-14B-Instruct-Q4_K_M.gguf"
# Present once the fine-tune has run; served as an adapter rather than merged so the base
# weights stay shared and reverting is a flag rather than a redeploy.
CHAT_ADAPTER = ROOT / "training" / "adapter" / "symoneural-lora.gguf"
FLUX_UNET = MODELS / "image" / "flux1-schnell-q4_k.gguf"
FLUX_VAE = MODELS / "image" / "ae.safetensors"
FLUX_CLIP = MODELS / "image" / "clip_l.safetensors"
FLUX_T5 = MODELS / "image" / "t5xxl-Q8_0.gguf"

CHAT_PORT = 8081
CHAT_PIDFILE = RUN / "chat.pid"

# Measured on this machine. Everything derived below uses these rather than
# vendor figures -- see the site's hardware section for the provenance.
MEASURED_DRAM_GBS = 752.0
MEASURED_H2D_GBS = 6.94
KV_RESERVE = 0.35  # held back from the weights budget for KV cache + activations

BOLD, DIM, GREEN, AMBER, OFF = "\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[0m"


def _tty() -> bool:
    return sys.stdout.isatty()


def c(text: str, colour: str) -> str:
    return f"{colour}{text}{OFF}" if _tty() else text


def smi(field: str) -> str:
    """One field out of nvidia-smi, or '' if the driver will not say."""
    try:
        out = subprocess.run(
            ["nvidia-smi", f"--query-gpu={field}", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10,
        )
        return out.stdout.strip().splitlines()[0].strip()
    except Exception:
        return ""


def sd_binary() -> Path | None:
    """stable-diffusion.cpp renamed its CLI mid-flight; accept either name."""
    for name in ("sd-cli", "sd"):
        candidate = SD_BUILD / name
        if candidate.exists():
            return candidate
    return None


def governor(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run([str(GOVERNOR), *args], text=True, check=False)


# --------------------------------------------------------------------------
# status / residency
# --------------------------------------------------------------------------

def cmd_status(_args) -> int:
    total = smi("memory.total") or "?"
    used = smi("memory.used") or "?"
    free = smi("memory.free") or "?"
    resident = (RUN / "resident").read_text().strip() if (RUN / "resident").exists() else "none"
    locked = (RUN / "gpu.lock.d").exists()

    print(f"{c('device', DIM)}             {smi('name') or 'unknown'}")
    print(f"{c('vram', DIM)}               {used} / {total} MiB used, {c(free + ' MiB free', GREEN)}")
    print(f"{c('power', DIM)}              {smi('power.draw') or '?'} W   {smi('temperature.gpu') or '?'} C")
    print(f"{c('resident surface', DIM)}   {resident}")
    print(f"{c('gpu lock', DIM)}           {c('HELD', AMBER) if locked else 'free'}")
    print()
    print(f"{c('chat', DIM)}   {'built' if (LLAMA_BIN / 'llama-server').exists() else c('not built', AMBER)}"
          f"   {'weights present' if CHAT_MODEL.exists() else c('weights missing', AMBER)}")
    sdb = sd_binary()
    print(f"{c('image', DIM)}  {'built' if sdb else c('not built', AMBER)}"
          f"   {'weights present' if FLUX_UNET.exists() else c('weights missing', AMBER)}")
    print(f"{c('ravencalc', DIM)}   always available {c('(cpu, no gpu, never queues)', DIM)}")
    # Only when something has written it. On a git checkout nothing has, and an invented
    # "never deployed" row would be a reading of a file that does not exist.
    verdict = last_deploy()
    if verdict:
        print()
        print(f"{c('last deploy', DIM)}        {verdict}")
    return 0


def cmd_residency(_args) -> int:
    """The residency plan, computed rather than asserted.

    Every figure here comes from the device or from a measured constant. Load
    times are weight bytes over the *measured* 6.94 GB/s pinned H2D rate, not
    the 7.88 GB/s the Gen 3 x8 link is theoretically worth.
    """
    free_mib = float(smi("memory.free") or 0)
    total_mib = float(smi("memory.total") or 0)
    free_gib = free_mib / 1024
    budget_gib = (total_mib / 1024) * (1 - KV_RESERVE)
    resident = (RUN / "resident").read_text().strip() if (RUN / "resident").exists() else "none"

    print(f"free                 {c(f'{free_gib:.1f} GiB', GREEN)}")
    print(f"weights budget       {c(f'{budget_gib:.1f} GiB', GREEN)}   "
          f"{c(f'({int(KV_RESERVE * 100)}% reserved for KV + activations)', DIM)}")
    print(f"resident surface     {c(resident, GREEN)}")
    print(f"headroom             {c(f'{max(0.0, free_gib - budget_gib):.1f} GiB', GREEN)}")
    print()

    costs = []
    for label, path in (("chat", CHAT_MODEL), ("image", FLUX_UNET)):
        if path.exists():
            gb = path.stat().st_size / 1e9
            costs.append(f"{label} {c(f'{gb / MEASURED_H2D_GBS * 1000:.0f} ms', AMBER)}")
    if costs:
        print("swap cost            " + "   ".join(costs) +
              f"   {c(f'(over the measured {MEASURED_H2D_GBS} GB/s host link)', DIM)}")
    print(f"resident : host      {c(f'{MEASURED_DRAM_GBS / MEASURED_H2D_GBS:.0f}x', GREEN)}"
          f"   {c(f'({MEASURED_DRAM_GBS:.0f} GB/s on-card vs {MEASURED_H2D_GBS} GB/s across PCIe)', DIM)}")
    return 0


# --------------------------------------------------------------------------
# chat
# --------------------------------------------------------------------------

SYSTEM_PROMPT = (
    "You are SyMoNeuRaL, running locally on the workstation you are being asked about. "
    "Answer concisely and concretely. These are the machine's measured figures, and you may "
    "cite them: NVIDIA RTX 5070 Ti, Blackwell sm_120, 70 SMs x 128 = 8,960 CUDA cores, "
    "15.92 GiB VRAM (15,858 MB), 256-bit bus at 14,001 MHz, 896.1 GB/s theoretical DRAM "
    "bandwidth, ~752 GB/s measured (~84% of peak), 48 MB L2, PCIe Gen 3 x8 host cap "
    "(device supports Gen 5) giving ~6.94 GB/s H2D and ~7.20 GB/s D2H pinned. Decode is "
    "memory-bandwidth bound: every token reads the full weight set once, so tokens/second "
    "is roughly bandwidth divided by weight bytes. Do not invent numbers you were not given."
)


def chat_running() -> bool:
    if not CHAT_PIDFILE.exists():
        return False
    try:
        os.kill(int(CHAT_PIDFILE.read_text().strip()), 0)
        return True
    except Exception:
        return False


# --------------------------------------------------------------------------
# upgrade
# --------------------------------------------------------------------------

def last_deploy() -> str:
    """The postinst's one-line verdict, or '' when nothing has ever written it."""
    try:
        return (STATE / "last-deploy").read_text().strip().splitlines()[0]
    except (OSError, IndexError):
        return ""


def unit_is_active() -> bool:
    """Whether systemd is running the API here. `is-active`, not `is-enabled`: a unit that
    is enabled but deliberately stopped must stay stopped, and `restart` would start it."""
    try:
        return subprocess.run(["systemctl", "is-active", "--quiet", UNIT],
                              check=False, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def sudo_argv(args) -> list[str]:
    """The re-exec line. Built here rather than inline so a test can read it without
    running it -- there is no dry-run mode for `sudo` itself."""
    argv = ["sudo", sys.executable, str(Path(__file__).resolve()), "upgrade"]
    if args.no_restart:
        argv.append("--no-restart")
    return argv


def cmd_upgrade(args) -> int:
    """Republish the staged site and restart the service: the no-apt path to a deploy.

    This does NOT reimplement `scripts/deploy.sh`. That script owns the orphan scan, the
    `--prune` semantics and the reference check that can fail the publish, and a second
    implementation of any of those would drift from it silently. This calls it.
    """
    apt_list = Path("/etc/apt/sources.list.d/symoneural.list")
    print(f"{c('deploy', DIM)}             {DEPLOY} --prune")
    print(f"{c('service', DIM)}            {UNIT} "
          f"{c('active', GREEN) if unit_is_active() else c('not active here', DIM)}")
    previous = last_deploy()
    if previous:
        print(f"{c('last deploy', DIM)}        {previous}")
    if apt_list.exists():
        print(f"{c('apt', DIM)}                {apt_list} exists, so "
              f"`sudo apt update && sudo apt upgrade` does this too")

    if not DEPLOY.is_file():
        print(f"{c('no ' + str(DEPLOY), AMBER)} -- this checkout cannot publish", file=sys.stderr)
        return 1

    if args.check:
        print()
        print("--check: nothing was run. Drop the flag to publish.")
        return 0

    # The webroot is root-owned, so this needs root and does not have it. Re-exec rather
    # than printing an instruction: the alternative is a command that only ever tells you
    # to run a different command.
    if os.geteuid() != 0:
        argv = sudo_argv(args)
        if shutil.which("sudo") is None:
            print("not root, and no sudo on PATH:", " ".join(argv), file=sys.stderr)
            return 1
        print()
        print(f"{c('re-exec', DIM)}            {' '.join(argv)}")
        sys.stdout.flush()
        os.execvp(argv[0], argv)

    print()
    rc = subprocess.run([str(DEPLOY), "--prune"], check=False).returncode
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    verdict = f"ok: {stamp}" if rc == 0 else f"FAILED: {stamp} -- symoneural-cli upgrade"
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / "last-deploy").write_text(verdict + "\n")
    except OSError as exc:
        # Not fatal: the publish either happened or it did not, and that is what matters.
        # Saying so beats a silent gap in a file two commands read as history.
        print(f"could not record the verdict in {STATE / 'last-deploy'}: {exc}", file=sys.stderr)
    if rc != 0:
        print(c(f"deploy failed (exit {rc}); the service was left alone", AMBER), file=sys.stderr)
        return rc

    if args.no_restart:
        print(c(f"--no-restart: {UNIT} left as it was", DIM))
    elif unit_is_active():
        print(f"restarting {UNIT}")
        if subprocess.run(["systemctl", "restart", UNIT], check=False).returncode != 0:
            print(c(f"restart failed -- journalctl -u {UNIT}", AMBER), file=sys.stderr)
            return 1
    else:
        print(f"{UNIT} is not active here, so nothing was restarted")
    print(f"{c('recorded', DIM)}           {verdict}")
    return 0


def cmd_stop_chat(_args) -> int:
    if CHAT_PIDFILE.exists():
        try:
            os.kill(int(CHAT_PIDFILE.read_text().strip()), 15)
        except Exception:
            pass
        CHAT_PIDFILE.unlink(missing_ok=True)
    subprocess.run(["pkill", "-f", "llama-server"], check=False)
    return 0


def cmd_chat(args) -> int:
    server = LLAMA_BIN / "llama-cli"
    if not server.exists():
        print("chat engine is not built yet -- run the build first", file=sys.stderr)
        return 1
    prompt = args.prompt or sys.stdin.read().strip()
    if not prompt:
        print("nothing to say", file=sys.stderr)
        return 2

    model = CHAT_MODEL_HEAVY if args.heavy else CHAT_MODEL
    if not model.exists():
        print(f"weights missing: {model}", file=sys.stderr)
        return 1

    cmd = [
        str(server), "-m", str(model),
        "-ngl", "99", "--no-warmup",
        "-sys", SYSTEM_PROMPT,
        "-p", prompt,
        "-n", str(args.max_tokens), "--temp", str(args.temperature),
        # -st exits after one turn. -no-cnv alone still drops into the interactive UI in
        # this build and waits on stdin, which is an unbounded hang inside a governor hold.
        "-no-cnv", "-st",
    ]
    # The adapter only matches the 7B base it was trained on; asking llama.cpp to apply it to
    # the 14B would be a rank/shape error, so it is simply not offered there.
    if not args.heavy and not args.no_adapter and CHAT_ADAPTER.exists():
        cmd += ["--lora", str(CHAT_ADAPTER)]
    started = time.time()
    rc = subprocess.run([str(GOVERNOR), "with", "chat", "--", *cmd], check=False).returncode
    print(f"\n{c(f'{time.time() - started:.1f}s wall clock', DIM)}", file=sys.stderr)
    return rc


# --------------------------------------------------------------------------
# image
# --------------------------------------------------------------------------

def cmd_image(args) -> int:
    sdb = sd_binary()
    if not sdb:
        print("image engine is not built yet -- run the build first", file=sys.stderr)
        return 1
    missing = [str(p) for p in (FLUX_UNET, FLUX_VAE, FLUX_CLIP, FLUX_T5) if not p.exists()]
    if missing:
        print("weights missing:\n  " + "\n  ".join(missing), file=sys.stderr)
        return 1

    out = Path(args.output).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    cmd = [
        str(sdb),
        "--diffusion-model", str(FLUX_UNET),
        "--vae", str(FLUX_VAE),
        "--clip_l", str(FLUX_CLIP),
        "--t5xxl", str(FLUX_T5),
        "-p", args.prompt,
        "--cfg-scale", "1.0",          # schnell is distilled; cfg above 1 degrades it
        "--sampling-method", "euler",
        "--steps", str(args.steps),
        "-W", str(args.size), "-H", str(args.size),
        "-o", str(out),
        "--seed", str(args.seed),
    ]
    if args.clip_on_cpu:
        # --clip-on-cpu is deprecated in current sd.cpp; te=cpu is the replacement. Tiling
        # and flash attention are what make 768x768 fit at all on 15.92 GiB.
        cmd += ["--backend", "te=cpu"]
    cmd += ["--vae-tiling", "--diffusion-fa"]

    started = time.time()
    rc = subprocess.run([str(GOVERNOR), "with", "image", "--", *cmd], check=False).returncode
    elapsed = time.time() - started
    if rc == 0 and out.exists():
        print(f"{c(str(out), GREEN)}  {out.stat().st_size / 1024:.0f} KB  "
              f"{args.size}x{args.size}  {args.steps} steps  seed {args.seed}  "
              f"{c(f'{elapsed:.1f}s', AMBER)}")
    return rc


# --------------------------------------------------------------------------
# ravencalc -- no GPU, no lock, no queue
# --------------------------------------------------------------------------

def cmd_ravencalc(args) -> int:
    sys.path.insert(0, str(ROOT / "backend" / "apps" / "ravencalc"))
    try:
        import ravencalc
    except ImportError as exc:
        print(f"ravencalc is not importable: {exc}", file=sys.stderr)
        return 1

    doc = {"schema": "ravencalc/request/v1", "operation": args.operation,
           "expression": args.expression}
    if args.variable:
        doc["variable"] = args.variable
    if args.point:
        doc["point"] = args.point

    try:
        result = ravencalc.run_request(doc)
    except ravencalc.RavenCalcError as exc:
        print(json.dumps(exc.as_record(), indent=2) if args.json else f"refused: {exc}",
              file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, indent=2, default=str))
        return 0

    print(f"{c('in ', DIM)} {result['input'].get('text')}")
    print(f"{c('out', DIM)} {c(str(result['result'].get('text')), GREEN)}")
    check = result.get("check") or {}
    if check.get("performed"):
        verdict = {True: c("verified", GREEN), False: c("FAILED", AMBER)}.get(
            check.get("passed"), c("unconfirmed", AMBER))
        print(f"{c('chk', DIM)} {verdict} {c('-- ' + str(check.get('how', '')), DIM)}")
    print(f"{c('eng', DIM)} {result.get('engine')}  {c('exact' if result.get('exact') else 'symbolic', DIM)}")
    return 0


# ---------------------------------------------------------------------------
# The studio surface: connectors, tools, and the agent loop.
#
# `backend/apps/symoneuralstudio` is the capable half of this stack -- 26 registered tools in
# four groups, native tool calling, an SSE agent loop and an MCP transport -- and until now
# none of it was reachable without a browser or a hand-written curl. The four subcommands
# below are that surface in a terminal.
#
# They are a client and nothing else. Every option here maps to a parameter the endpoint
# actually reads -- `query`, `history`, `max_steps`, `context`, `model`, which is the whole list
# `POST /api/studio/agent` accepts -- and every field printed is one the response actually
# carries. There is no client-side tool filtering and no permission mode, because the server
# has no such parameters: a flag the endpoint ignores is a lie with a help string.
#
# `history` is the one that needs saying out loud. The endpoint reads it (`routes.py`, and
# `agent.run()` splices it between the system prompt and the new question), so the CLI carries
# it: `-c` sends back a transcript this command itself recorded under `run/`. The server keeps
# no session state of its own -- the file is the session, and it is the client's to hold.
# ---------------------------------------------------------------------------

DEFAULT_API = os.environ.get("SYM_API_URL", "http://127.0.0.1:8800")
# Word for word what `/api/studio/state` returns as its own `detail` when the switch is off,
# so the CLI and the endpoint cannot drift into saying different things about the same gate.
GATE_HINT = "set SYM_STUDIO_ENABLED=1 and SYM_STUDIO_TOKEN=<secret>, then restart the API"


def studio_token() -> str:
    """The operator token, read from the environment and never printed -- only sent."""
    return os.environ.get("SYM_STUDIO_TOKEN") or ""


def require_token() -> bool:
    if studio_token():
        return True
    print(f"no SYM_STUDIO_TOKEN in this environment: {GATE_HINT}", file=sys.stderr)
    print(c("the token is the API's own, kept in /etc/symoneural/api.env (root, 0600); "
            "export the same value here", DIM), file=sys.stderr)
    return False


def api_open(path: str, *, base: str, method: str = "GET", body: object = None,
             accept: str = "application/json", timeout: float = 30.0):
    """Open one request against the studio router and hand back the live response.

    stdlib `urllib`, so the module docstring's dependency claim stays true. An SSE stream is
    newline-delimited chunks over a socket that stays open; nothing here needs a client
    library, and `urlopen` iterates a chunked response line by line as it arrives.
    """
    import urllib.request

    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(base.rstrip("/") + path, data=data, method=method)
    req.add_header("Accept", accept)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    if (token := studio_token()):
        req.add_header("X-Sym-Token", token)
    return urllib.request.urlopen(req, timeout=timeout)


def api_json(path: str, *, base: str, method: str = "GET", body: object = None,
             timeout: float = 60.0) -> tuple[int, dict]:
    """`(status, body)`. A 4xx is a result here, not an exception: the router answers `denied`,
    `unknown_tool` and `empty_query` as JSON, and those bodies are the useful part."""
    import urllib.error

    try:
        with api_open(path, base=base, method=method, body=body, timeout=timeout) as r:
            raw = r.read().decode(errors="replace")
            return r.status, (json.loads(raw) if raw.strip() else {})
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode(errors="replace")
        try:
            return exc.code, json.loads(raw)
        except ValueError:
            return exc.code, {"error": raw.strip()[:400] or f"HTTP {exc.code}"}
    except urllib.error.URLError as exc:
        return 0, {"error": "unreachable", "detail": str(exc.reason)}


def unreachable(base: str, obj: dict) -> int:
    print(f"no API at {base} -- {obj.get('detail') or obj.get('error')}", file=sys.stderr)
    print("start one:  cd backend && python3 -m uvicorn api:app --port 8800", file=sys.stderr)
    return 1


def local_registry():
    """The tool registry as this checkout defines it, imported in-process.

    This is the same object `agent.py` generates its system prompt from and `mcp_server.py`
    iterates, so `tools` tells the truth about what the model can call without an API to ask.
    It costs the backend's imports -- stdlib plus httpx, both already in the serving path --
    and `tools --remote` is there for when the live reading is the point.
    """
    sys.path.insert(0, str(ROOT / "backend"))
    from apps.symoneuralstudio import registry, tools_impl  # noqa: F401  (registers the tools)
    return registry


def transcript_path(session: str) -> Path:
    """`run/agent-<session>.json` -- where a multi-turn thread is kept.

    `run/` is this repo's runtime state and this is runtime state, so it goes there rather than
    into a dotfile in `$HOME`. The name is filtered down to letters, digits, dash and underscore
    because it becomes a filename; an empty result falls back to `default` instead of writing
    `agent-.json`.
    """
    safe = "".join(ch if (ch.isalnum() or ch in "-_") else "-" for ch in session).strip("-")
    return RUN / f"agent-{safe or 'default'}.json"


def transcript_read(path: Path) -> list[dict]:
    """The stored thread, or `[]`.

    Only messages with a string `role` and `content` survive: the file is fed straight to the
    endpoint as `history`, and a half-written or hand-edited entry would come back as a 422
    from somewhere far away from here. A malformed file reads as empty rather than raising --
    the thread is a convenience, and losing it must not take the turn down with it.
    """
    try:
        loaded = json.loads(path.read_text())
    except (OSError, ValueError):
        return []
    if not isinstance(loaded, list):
        return []
    return [m for m in loaded
            if isinstance(m, dict) and isinstance(m.get("role"), str)
            and isinstance(m.get("content"), str)]


def transcript_write(path: Path, messages: list[dict]) -> None:
    """Replace the thread on disk. Failures are reported, not raised: the answer already
    arrived, and an unwritable `run/` is not a reason to exit non-zero after a good turn."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(messages, indent=1) + "\n")
    except OSError as exc:
        print(c(f"could not record the turn in {path}: {exc}", AMBER), file=sys.stderr)


# ---------------------------------------------------------------------------


def cmd_state(args) -> int:
    """What the stack reports about itself, tokenless: `GET /api/studio/state`."""
    status, obj = api_json("/api/studio/state", base=args.url, timeout=20.0)
    if status == 0:
        return unreachable(args.url, obj)
    if args.json:
        print(json.dumps(obj, indent=2, sort_keys=True))
        return 0 if status == 200 else 1

    def row(label: str, value: str) -> None:
        print(f"{label:<20} {value}")

    on = bool(obj.get("enabled"))
    row("surface", c("on", GREEN) if on else c("off", AMBER))
    if not on:
        row("", c(str(obj.get("detail") or GATE_HINT), DIM))
    ws = obj.get("workspace") or {}
    row("workspace", str(ws.get("root") or c("not found -- set SYM_STUDIO_ROOT", AMBER)))
    row("tools", str(obj.get("tools", "?")))
    row("max steps", str(obj.get("max_steps", "?")))
    for name, b in (obj.get("inference") or {}).get("backends", {}).items():
        up = b.get("up")
        models = ", ".join(b.get("models") or []) if up else ""
        row(f"inference {name}", (c("up", GREEN) + (f"  {models}" if models else ""))
            if up else c("down", AMBER))
        if not up and b.get("detail") and args.why:
            row("", c(str(b["detail"]), DIM))
    cu = obj.get("comfyui") or {}
    row("comfyui", c("up", GREEN) if cu.get("up") else c("down", AMBER))
    lease = obj.get("lease") or {}
    row("gpu lease", c("held", AMBER) if lease.get("holding") else c("not held", GREEN))
    row("workflows", ", ".join(obj.get("workflows") or []) or "none")
    if (pinned := (obj.get("inference") or {}).get("pinned")):
        row("SYM_STUDIO_LLM", str(pinned))
    return 0


def cmd_tools(args) -> int:
    """The tool registry -- names, groups, and the JSON Schema the model is handed."""
    if args.remote:
        if not require_token():
            return 2
        status, obj = api_json("/api/studio/tools", base=args.url, timeout=20.0)
        if status == 0:
            return unreachable(args.url, obj)
        if status != 200:
            print(f"HTTP {status}: {json.dumps(obj)}", file=sys.stderr)
            return 1
        entries = obj.get("tools") or []
        specs = obj.get("specs") or []
        source = f"live from {args.url}"
    else:
        try:
            registry = local_registry()
        except Exception as exc:  # noqa: BLE001 -- report the import, do not pretend
            print(f"cannot import the registry: {type(exc).__name__}: {exc}", file=sys.stderr)
            print("try:  symoneural-cli tools --remote", file=sys.stderr)
            return 1
        entries = [{"name": t.name, "group": t.group, "dangerous": t.dangerous,
                    "description": t.description, "parameters": t.parameters}
                   for t in sorted(registry.TOOLS.values(), key=lambda t: (t.group, t.name))]
        specs = registry.tool_specs()
        source = f"this checkout ({ROOT.name})"

    if args.name:
        entries = [e for e in entries if e["name"] == args.name]
        specs = [s for s in specs
                 if (s.get("function") or {}).get("name") == args.name or
                 s.get("name") == args.name]
        if not entries:
            print(f"no tool named {args.name!r}", file=sys.stderr)
            return 1
    if args.group:
        entries = [e for e in entries if e["group"] == args.group]
        keep = {e["name"] for e in entries}
        specs = [s for s in specs
                 if ((s.get("function") or {}).get("name") or s.get("name")) in keep]
        if not entries:
            print(f"no tools in group {args.group!r}", file=sys.stderr)
            return 1
    if args.json:
        # The OpenAI tool-spec shape, exactly as it goes into the request the model sees.
        print(json.dumps(specs, indent=2))
        return 0

    if args.name:
        e = entries[0]
        print(f"{c(e['name'], BOLD)}  {c(e['group'], DIM)}"
              f"{'  ' + c('writes', AMBER) if e['dangerous'] else ''}")
        print(f"  {e['description'] or '(no description)'}")
        props = (e.get("parameters") or {}).get("properties") or {}
        required = set((e.get("parameters") or {}).get("required") or [])
        for pname, schema in props.items():
            kind = schema.get("type", "any")
            mark = "" if pname in required else c(" optional", DIM)
            print(f"    {pname:<18} {kind}{mark}")
            if schema.get("description"):
                print(f"      {c(str(schema['description']), DIM)}")
        if not props:
            print(f"    {c('no parameters', DIM)}")
        return 0

    group = None
    room = max(24, shutil.get_terminal_size((100, 24)).columns - 32)
    for e in entries:
        if e["group"] != group:
            group = e["group"]
            print(f"\n{c(group, BOLD)}")
        flag = c(" writes", AMBER) if e["dangerous"] else ""
        first = (e["description"] or "").strip().splitlines()[0] if e["description"] else ""
        if len(first) > room:  # clipped on a word, and it says so, rather than mid-word
            first = first[:room].rsplit(" ", 1)[0] + " ..."
        print(f"  {e['name']:<20}{first}{flag}")
    writes = sum(1 for e in entries if e["dangerous"])
    print(f"\n{len(entries)} tools, {writes} of which write  {c(source, DIM)}")
    return 0


def cmd_tool(args) -> int:
    """Run one tool directly: `POST /api/studio/tool/{name}`, no model in the path.

    The route's own docstring calls this an operator surface reached with curl and a token.
    This is that, with the arguments parsed for you.
    """
    if not require_token():
        return 2
    arguments: dict = {}
    if args.body:
        try:
            arguments = json.loads(args.body)
        except ValueError as exc:
            print(f"--body is not JSON: {exc}", file=sys.stderr)
            return 2
        if not isinstance(arguments, dict):
            print("--body must be a JSON object", file=sys.stderr)
            return 2
    for pair in args.arg:
        if "=" not in pair:
            print(f"arguments are key=value, got {pair!r}", file=sys.stderr)
            return 2
        key, _, raw = pair.partition("=")
        try:  # so numbers, booleans, null and nested JSON arrive as themselves
            arguments[key] = json.loads(raw)
        except ValueError:
            arguments[key] = raw
    started = time.monotonic()
    status, obj = api_json(f"/api/studio/tool/{args.name}", base=args.url,
                           method="POST", body=arguments, timeout=args.timeout)
    if status == 0:
        return unreachable(args.url, obj)
    if status == 404 and obj.get("error") == "unknown_tool":
        print(f"no tool named {args.name!r}", file=sys.stderr)
        print(f"{len(obj.get('available') or [])} available -- "
              f"symoneural-cli tools", file=sys.stderr)
        return 1
    if status != 200:
        print(f"HTTP {status}: {json.dumps(obj)}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(obj, indent=2, default=str))
        return 0 if obj.get("ok") else 1
    wall = time.monotonic() - started
    if not obj.get("ok"):
        print(c(f"{args.name} failed: {obj.get('error')}", AMBER), file=sys.stderr)
        return 1
    result = obj.get("result")
    print(result if isinstance(result, str) else json.dumps(result, indent=2, default=str))
    note = (f"{args.name} ok  server {obj.get('elapsed_s')}s  wall {wall:.2f}s")
    print(c(note, DIM), file=sys.stderr)
    return 0


def _one_line(value: object, width: int) -> str:
    """A result rendered on one line, with its own size stated rather than hidden."""
    text = value if isinstance(value, str) else json.dumps(value, default=str)
    flat = " ".join(text.split())
    if len(flat) <= width:
        return flat
    return f"{flat[:width]}... ({len(text)} chars)"


def cmd_agent(args) -> int:
    """Drive one agent turn and render the SSE stream as it arrives.

    The frames are `agent.run()`'s own, unchanged: backend, thinking, tool_call, tool_result,
    answer, error, done, notice. Anything else the loop grows later prints as raw JSON rather
    than being dropped -- a renderer that silently ignores an event it does not know is how a
    terminal ends up quieter than the thing it is watching.

    Multi-turn is client-side by necessity: the endpoint reads a `history` list but stores
    nothing between calls, so the thread lives in `run/agent-<session>.json` and `-c` sends it.
    """
    path = transcript_path(args.session)
    if args.forget:
        existing = transcript_read(path)
        if path.exists():
            path.unlink()
            print(f"forgot {path} ({len(existing)} messages)")
        else:
            print(f"nothing recorded in {path}")
        return 0

    if not require_token():
        return 2
    query = " ".join(args.query).strip()
    if not query:
        print("nothing to ask", file=sys.stderr)
        return 2
    body: dict = {"query": query}

    prior: list[dict] = []
    if args.cont:
        stored = transcript_read(path)
        prior = stored
        if args.history_limit and len(prior) > args.history_limit:
            prior = prior[-args.history_limit:]
            # A window that starts on an assistant turn asks the model to continue a reply to a
            # question it cannot see, so the clip moves forward to the first user message.
            while prior and prior[0].get("role") != "user":
                prior = prior[1:]
        if not stored:
            print(c(f"history: nothing recorded in {path.name} yet", DIM), file=sys.stderr)
        elif len(prior) < len(stored):
            print(c(f"history: sending the last {len(prior)} of {len(stored)} messages in "
                    f"{path.name} (--history-limit {args.history_limit})", DIM), file=sys.stderr)
        else:
            print(c(f"history: {len(prior)} messages from {path.name}", DIM), file=sys.stderr)
    if prior:
        body["history"] = prior

    if args.max_steps:
        body["max_steps"] = args.max_steps
    if args.model:
        body["model"] = args.model
    if args.context:
        body["context"] = args.context

    import urllib.error

    try:
        resp = api_open("/api/studio/agent", base=args.url, method="POST", body=body,
                        accept="text/event-stream", timeout=args.timeout)
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode(errors="replace")
        try:
            detail = json.dumps(json.loads(raw))
        except ValueError:
            detail = raw.strip()[:400]
        print(f"HTTP {exc.code}: {detail}", file=sys.stderr)
        return 1
    except urllib.error.URLError as exc:
        return unreachable(args.url, {"detail": str(exc.reason)})

    t0 = time.monotonic()
    frames: list[dict] = []
    answer = ""
    failed = False
    width = shutil.get_terminal_size((100, 24)).columns
    with resp:
        for raw in resp:
            line = raw.decode("utf-8", errors="replace").strip()
            if not line.startswith("data:"):
                continue
            try:
                frame = json.loads(line[5:].strip())
            except ValueError:
                continue
            frames.append(frame)
            kind = frame.get("event")
            if kind == "answer":
                answer = frame.get("text") or ""
            if kind == "error":
                failed = True
            if args.output_format == "stream-json":
                print(json.dumps(frame, default=str), flush=True)
                continue
            if args.output_format == "json":
                continue
            stamp = c(f"{time.monotonic() - t0:6.2f}s", DIM)
            if kind == "backend":
                print(f"{stamp} {c('backend', BOLD)} {frame.get('name')} "
                      f"{c(str(frame.get('url') or ''), DIM)}")
            elif kind == "thinking":
                for para in (frame.get("text") or "").strip().splitlines():
                    if para.strip():
                        print(f"{stamp} {c(para.strip(), DIM)}")
            elif kind == "tool_call":
                print(f"{stamp} {c('call', GREEN)} {frame.get('name')}"
                      f"({_one_line(frame.get('arguments'), max(20, width - 30))})")
            elif kind == "tool_result":
                shown = (json.dumps(frame.get('result'), indent=2, default=str)
                         if args.verbose else _one_line(frame.get("result"),
                                                        max(20, width - 30)))
                print(f"{stamp} {c('   ->', DIM)} {shown}")
            elif kind == "answer":
                print(f"{stamp} {c('answer', BOLD)}"
                      f"{c('  (step limit reached)', AMBER) if frame.get('truncated') else ''}")
                print(answer.strip())
            elif kind == "notice":
                print(f"{stamp} {c('notice', AMBER)} {frame.get('detail')}")
            elif kind == "error":
                print(f"{stamp} {c('error', AMBER)} {frame.get('code')}: "
                      f"{frame.get('detail')}", file=sys.stderr)
            elif kind == "done":
                used, secs = frame.get("tools_used"), frame.get("seconds")
                print(f"{stamp} {c('done', DIM)} {c(str(frame.get('steps')) + ' steps', DIM)}"
                      + (c(f", tools {used}", DIM) if used else "")
                      + (c(f", {secs}s server-side", DIM) if secs is not None else "")
                      + (c(", hit the step limit", AMBER) if frame.get("hit_step_limit")
                         else ""))
            else:  # an event this renderer has not been taught: show it, do not swallow it
                print(f"{stamp} {c('?', AMBER)} {json.dumps(frame, default=str)}")

    # Record the exchange whether or not this turn read the thread, so that a later `-c` has
    # something to send. A failed turn is not appended: half a turn is worse than none.
    if answer and not failed and not args.no_save:
        transcript_write(path, transcript_read(path)
                         + [{"role": "user", "content": query},
                            {"role": "assistant", "content": answer}])

    if args.output_format == "json":
        print(json.dumps({"query": query, "answer": answer, "events": frames,
                          "session": args.session, "history_sent": len(prior),
                          "elapsed_s": round(time.monotonic() - t0, 3),
                          "ok": not failed}, indent=2, default=str))
    return 1 if failed else 0


def cmd_mcp(args) -> int:
    """The MCP transport: what it would serve, whether it can start, and how to wire a client.

    `mcp_server.py` iterates the same registry the agent does, so the tool list here is not a
    second copy -- it is the same 26 functions over a different transport. The venv is the only
    thing FastMCP is installed into; without it this reports the gap instead of guessing.
    """
    pkg = ROOT / "backend" / "apps" / "symoneuralstudio"
    venv_py = pkg / ".venv" / "bin" / "python"
    server = pkg / "mcp_server.py"
    have_venv = venv_py.is_file()
    fastmcp = None
    if have_venv:
        probe = subprocess.run([str(venv_py), "-c",
                                "import fastmcp;print(fastmcp.__version__)"],
                               capture_output=True, text=True)
        fastmcp = probe.stdout.strip() if probe.returncode == 0 else None

    if args.serve:
        if not have_venv or not fastmcp:
            print("the MCP venv is not ready. build it, by full path, never into the system "
                  "interpreter:", file=sys.stderr)
            print(f"  python3 -m venv {pkg / '.venv'}", file=sys.stderr)
            print(f"  {pkg / '.venv/bin/pip'} install -r {pkg / 'requirements.txt'}",
                  file=sys.stderr)
            return 1
        cmd = [str(venv_py), str(server)] + (["--http", str(args.http)] if args.http else [])
        # exec, not spawn: on stdio the client owns this process's stdin and stdout, and an
        # intermediate python would sit in the middle of the transport for no reason.
        os.execv(cmd[0], cmd)

    try:
        registry = local_registry()
        count, groups = len(registry.TOOLS), sorted({t.group for t in registry.TOOLS.values()})
    except Exception as exc:  # noqa: BLE001
        count, groups = "?", []
        print(f"registry did not import: {type(exc).__name__}: {exc}", file=sys.stderr)

    def row(label: str, value: str) -> None:
        print(f"{label:<20} {value}")

    if args.json:
        print(json.dumps({"server": str(server), "venv": str(venv_py.parent.parent),
                          "venv_ready": bool(fastmcp), "fastmcp": fastmcp,
                          "tools": count, "groups": groups,
                          "stdio": [str(venv_py), str(server)],
                          "http": [str(venv_py), str(server), "--http", "PORT"]}, indent=2))
        return 0
    row("server", str(server))
    row("transport", "stdio (default), or --http PORT for streamable HTTP")
    row("fastmcp", f"{fastmcp}  {c(str(venv_py.parent.parent), DIM)}" if fastmcp
        else c("not installed -- symoneural-cli mcp --serve prints the two commands", AMBER))
    row("tools", f"{count} in {', '.join(groups)}" if groups else str(count))
    row("switch", c("on", GREEN) if os.environ.get("SYM_STUDIO_ENABLED") == "1"
        else c("SYM_STUDIO_ENABLED is not 1 in this shell", AMBER))
    print()
    print(f"{c('a client wires it as:', BOLD)}")
    print(json.dumps({"mcpServers": {"symoneural-studio": {
        "command": str(venv_py), "args": [str(server)],
        "env": {"SYM_STUDIO_ENABLED": "1", "SYM_STUDIO_TOKEN": "<secret>",
                "SYM_STUDIO_ROOT": str(ROOT)}}}}, indent=2))
    return 0


# --------------------------------------------------------------------------

def main() -> int:
    parser = argparse.ArgumentParser(
        prog="symoneural-cli", description="One command over the local SyMoNeuRaL stack.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="device, surfaces and lock state").set_defaults(fn=cmd_status)
    sub.add_parser("residency", help="the residency plan, computed live").set_defaults(fn=cmd_residency)

    p = sub.add_parser("upgrade", help="republish the site and restart the service (needs root)")
    p.add_argument("--check", action="store_true",
                   help="print what would happen and exit, without root and without deploying")
    p.add_argument("--no-restart", action="store_true",
                   help="publish the site but leave the service running the old code")
    p.set_defaults(fn=cmd_upgrade)

    p = sub.add_parser("chat", help="ask the local model (takes the GPU)")
    p.add_argument("prompt", nargs="?")
    p.add_argument("-n", "--max-tokens", type=int, default=512)
    p.add_argument("-t", "--temperature", type=float, default=0.7)
    p.add_argument("--heavy", action="store_true", help="use the 14B tier instead of the 7B")
    p.add_argument("--no-adapter", action="store_true", help="serve the stock base model")
    p.set_defaults(fn=cmd_chat)

    p = sub.add_parser("image", help="generate an image (takes the GPU)")
    p.add_argument("prompt")
    p.add_argument("-o", "--output", default=str(RUN / "out.png"))
    p.add_argument("--steps", type=int, default=4)
    p.add_argument("--size", type=int, default=768, choices=(512, 768, 1024))
    p.add_argument("--seed", type=int, default=42)
    p.add_argument("--clip-on-cpu", action="store_true", default=True)
    p.set_defaults(fn=cmd_image)

    p = sub.add_parser("ravencalc", help="exact mathematics (cpu, never queues)")
    p.add_argument("operation", choices=sorted(
        ("differentiate", "integrate", "limit", "series", "solve", "simplify", "evaluate")))
    p.add_argument("expression")
    p.add_argument("-v", "--variable")
    p.add_argument("--point")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_ravencalc)

    # The studio surface. `--url` and `--json` are repeated per subcommand rather than hung on
    # the top-level parser, because `symoneural-cli --json ravencalc ...` would then parse and
    # do nothing: ravencalc has its own `--json` and never speaks HTTP.
    def studio(name: str, help_text: str):
        q = sub.add_parser(name, help=help_text)
        q.add_argument("--url", default=DEFAULT_API,
                       help=f"the API to talk to (default {DEFAULT_API}, or $SYM_API_URL)")
        return q

    p = studio("agent", "one agent turn, streamed -- thinking, tool calls, results, answer")
    p.add_argument("query", nargs="*", help="what to ask")
    # `history` is a parameter the endpoint reads, so it gets a flag. The thread is a file this
    # command writes, because the server keeps no session state to resume.
    p.add_argument("-c", "--continue", dest="cont", action="store_true",
                   help="send the recorded thread as `history`, making this turn a reply")
    p.add_argument("--session", default="default", metavar="NAME",
                   help="which thread to use, kept in run/agent-NAME.json (default: default)")
    p.add_argument("--history-limit", type=int, default=20, metavar="N",
                   help="send at most the last N messages of it (default 20, 0 for all); "
                        "when it clips, it says so")
    p.add_argument("--no-save", action="store_true",
                   help="do not record this turn in the thread")
    p.add_argument("--forget", action="store_true",
                   help="delete the thread's file and exit")
    p.add_argument("--max-steps", type=int,
                   help="tool-calling rounds before the loop stops (server default 8)")
    p.add_argument("--model", help="override the backend's model name")
    p.add_argument("--context", help="extra context prepended to the system prompt")
    p.add_argument("--output-format", choices=("text", "json", "stream-json"), default="text",
                   help="text renders as it arrives; stream-json is one frame per line, "
                        "and json is a single object at the end")
    p.add_argument("-v", "--verbose", action="store_true",
                   help="print whole tool results instead of one line each")
    p.add_argument("--timeout", type=float, default=900.0)
    p.set_defaults(fn=cmd_agent)

    p = studio("tools", "the tool registry the model is handed")
    p.add_argument("name", nargs="?", help="one tool, with its full parameter schema")
    p.add_argument("--group", help="filter to one group")
    p.add_argument("--json", action="store_true", help="the OpenAI tool specs, verbatim")
    p.add_argument("--remote", action="store_true",
                   help="read the live registry over HTTP instead of this checkout")
    p.set_defaults(fn=cmd_tools)

    p = studio("tool", "run one tool directly, with no model in the path")
    p.add_argument("name")
    p.add_argument("arg", nargs="*", metavar="key=value",
                   help="values are parsed as JSON when they parse, else as strings")
    p.add_argument("--body", help="the whole argument object as JSON")
    p.add_argument("--json", action="store_true")
    p.add_argument("--timeout", type=float, default=300.0)
    p.set_defaults(fn=cmd_tool)

    p = studio("state", "what the stack reports about itself (no token needed)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--why", action="store_true",
                   help="also print each down backend's stated reason")
    p.set_defaults(fn=cmd_state)

    p = sub.add_parser("mcp", help="the MCP transport: tools, readiness, client wiring")
    p.add_argument("--serve", action="store_true",
                   help="exec the MCP server on stdio (this process becomes it)")
    p.add_argument("--http", type=int, metavar="PORT",
                   help="with --serve, streamable HTTP on 127.0.0.1:PORT instead of stdio")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_mcp)

    sub.add_parser("_stop-chat").set_defaults(fn=cmd_stop_chat)

    args = parser.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
