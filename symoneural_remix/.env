# symon_dj configuration — copy to .env and fill in. Loaded via python-dotenv;
# real environment variables win over this file.

# From the Spotify developer dashboard (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=47d7d960b5f548c19001abcac3b17242
SPOTIFY_CLIENT_SECRET=2a4eae4752a24017b1f0d1bcd75ed175

# Must be registered VERBATIM in the app's dashboard settings. Use 127.0.0.1,
# NOT localhost — Spotify rejects localhost redirect URIs for new apps.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8090/auth/callback

# The symon engine. Loopback only — never expose :9001 beyond this box.
SYMON_URL=http://127.0.0.1:9001
# The engine's bearer key, reused by name (exported in ~/.bashrc on this box,
# so a login shell already has it — leave empty here in that case).
VLLM_API_KEY=5bd873704e896009b79883612b316bd5c7fcf25fc0f7cac49d0f40bb54fb9b1e

# Bearer token the iOS app must send on every route except /health and the
# /auth/* browser flow. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# UNSET means symon_dj answers loopback peers only (the phone will get 401).
DJ_TOKEN=0b690a9c3ecfae17ddde8d6e46242fe95343821cef74a207

# Multi-user Spotify token store (0600). Relative paths resolve from the cwd
# symon_dj is started in — run.sh starts it from the project root.
DJ_TOKEN_PATH=.run/spotify_tokens.json

DJ_HOST=0.0.0.0
DJ_PORT=8090
